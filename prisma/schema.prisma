generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  nurse
  agency
  admin
}

enum ShiftRole {
  RN
  LPN
}

enum ShiftStatus {
  open
  filled
}

enum AuditAction {
  shift_claimed
}

model Agency {
  id     String  @id
  name   String
  users  User[]
  shifts Shift[]
}

model User {
  id            String       @id
  email         String       @unique
  name          String
  role          Role
  agencyId      String?
  agency        Agency?      @relation(fields: [agencyId], references: [id])
  passwordHash  String
  sessions      ApiSession[]
  claimedShifts Shift[]
  credential    Credential?
  auditEvents   AuditEvent[]
}

model ApiSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model LoginAttempt {
  id          String   @id @default(uuid())
  email       String
  attemptedAt DateTime @default(now())

  @@index([email, attemptedAt])
}

model Shift {
  id          String      @id
  agencyId    String
  agency      Agency      @relation(fields: [agencyId], references: [id])
  role        ShiftRole
  date        DateTime    @db.Date
  startTime   String      @db.Char(5)
  endTime     String      @db.Char(5)
  status      ShiftStatus @default(open)
  claimedById String?
  claimedBy   User?       @relation(fields: [claimedById], references: [id])
  createdAt   DateTime    @default(now())

  @@index([agencyId, date, startTime])
}

model Credential {
  id        String   @id @default(uuid())
  nurseId   String   @unique
  nurse     User     @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  expiresOn DateTime @db.Date
  updatedAt DateTime @updatedAt
}

model AuditEvent {
  id           String      @id @default(uuid())
  actorId      String
  actor        User        @relation(fields: [actorId], references: [id])
  action       AuditAction
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([resourceType, resourceId])
}

# Copy to .env.development (dev branch) and .env (production branch).
# Both files are gitignored. Never commit real values.
#
# Which tool reads which file:
#   next dev, Playwright, Vitest, Prisma CLI, db:seed  -> .env.development over .env  (dev branch)
#   next build, next start                              -> .env                       (production branch)
#
# Every key the app reads must exist in .env.development: Next layers .env
# underneath it, so a key missing there silently falls back to production.

# Pooled connection. All application traffic.
DATABASE_URL=
# Direct connection. Migrations and seeding.
DATABASE_URL_UNPOOLED=
# "dev" in .env.development, "production" in .env. Guards seeding, migrations and tests.
NEON_BRANCH=
# Signs session tokens (HS256). Different per file. Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=

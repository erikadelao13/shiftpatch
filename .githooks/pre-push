#!/bin/sh
# Full verification from docs/VERIFICATION.md before work leaves the machine.
# Inspects the working tree, not the pushed revision.
set -eu

cd "$(git rev-parse --show-toplevel)"

# Git sends "<local ref> <local sha> <remote ref> <remote sha>" per update.
# An all-zero local sha means a branch deletion: nothing to verify.
has_content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) has_content=1 ;;
  esac
done

if [ "$has_content" -eq 0 ]; then
  echo "pre-push: no ref update with content (deletion-only or empty stdin); skipping verification."
  exit 0
fi

# Use the Node pinned in .nvmrc when nvm has it; the shell default may be
# older than Next.js requires (TD-7). Otherwise PATH is left alone.
if node_bin=$(python3 scripts/pinned_node.py); then
  PATH="$node_bin:$PATH"
  export PATH
fi

pnpm verify

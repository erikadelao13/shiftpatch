{
  "name": "shiftpatch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:production": "NODE_ENV=production tsx prisma/seed.ts --production",
    "db:deploy": "prisma migrate deploy",
    "check:docs": "python3 scripts/check_harness.py",
    "test:e2e": "playwright test",
    "verify": "pnpm check:docs && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:e2e",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "^3.10.1",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.27.0"
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/.next/**)",
      "Edit(/node_modules/**)",
      "Edit(/next-env.d.ts)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/CLAUDE.md)",
      "Edit(/CLAUDE.local.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py"],
            "timeout": 15,
            "statusMessage": "Loading shiftpatch plan context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py"],
            "timeout": 15,
            "statusMessage": "Checking shiftpatch documentation"
          }
        ]
      }
    ]
  }
}
